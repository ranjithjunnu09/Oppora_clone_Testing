# Copy to .env and fill in whichever providers you want to use. Never commit .env.

# ── Anthropic (the default benchmark target) ─────────────────────────────────
# Claude models are reached through Anthropic's OpenAI-SDK compatibility layer,
# so the 9 feature files need no changes. Any model named claude-* routes here.
#   https://docs.anthropic.com/en/api/openai-sdk
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (the production baseline) ────────────────────────────────────────
# Optional. Without it you can still run Claude, but you lose the ability to
# compare against the gpt-4.1-mini / o4-mini numbers production actually runs.
OPENAI_API_KEY=sk-...

# ── Self-hosted / other OpenAI-compatible endpoint ──────────────────────────
# Optional. Can also be set per-run from the UI header, which overrides routing.
# OPENAI_BASE_URL=http://localhost:8000/v1

# ── Run database ────────────────────────────────────────────────────────────
# Optional. Set this if the repo lives on a network share or mounted volume:
# SQLite needs real file locking and will otherwise fail with "disk I/O error".
# OPPORA_DB_PATH=C:\Users\you\oppora-runs.db
